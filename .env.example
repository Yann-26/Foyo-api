# Copy to .env and adjust.
# development (demo data, permissive defaults) or production (the default: strict checks at start-up)
ENVIRONMENT=development
# SQLite by default; production: postgresql+psycopg://foyo:foyo@localhost:5432/foyo
DATABASE_URL=sqlite:///./foyo.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_DAYS=30
# Demo household with a known password: development only (refused in production).
SEED_DEMO=true
# Browser origins allowed to call the API (the mobile app needs none), e.g. ["https://admin.foyo.app"]
# CORS_ORIGINS=[]
TIMEZONE=Africa/Abidjan
PUBLIC_BASE_URL=https://foyo.app
# E-mail: "log" prints messages in the server log; "smtp" sends them (Gmail below).
EMAIL_BACKEND=log
PASSWORD_RESET_MINUTES=30
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Foyo
# Push notifications: "log" prints them in the server log; "fcm" sends them with Firebase.
# Firebase console → Project settings → Service accounts → Generate new private key (keep it secret).
PUSH_BACKEND=log
FCM_CREDENTIALS_FILE=

# RevenueCat webhook Authorization header value
REVENUECAT_WEBHOOK_SECRET=

# Uploaded photos (task proof, receipts): a persistent volume in production
MEDIA_DIR=./media

# Reverse proxy address(es) whose X-Forwarded-For is trusted (client IPs for rate limits), e.g. 172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1
# Telemetry limits (per API process): requests/min per IP and per install, events/h and crashes/h per install
TELEMETRY_IP_REQUESTS_PER_MINUTE=120
TELEMETRY_INSTALL_REQUESTS_PER_MINUTE=20
TELEMETRY_INSTALL_EVENTS_PER_HOUR=2000
TELEMETRY_IP_CRASHES_PER_MINUTE=30
TELEMETRY_INSTALL_CRASHES_PER_HOUR=30
