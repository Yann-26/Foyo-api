# HTTPS in front of the API. Caddy gets and renews the Let's Encrypt certificate for $DOMAIN by itself
# (the domain's DNS must point to this server, ports 80 and 443 open).
{$DOMAIN} {
	encode zstd gzip

	# Photos are 5 MB at most; leave room for the multipart envelope.
	request_body {
		max_size 10MB
	}

	# Caddy sets X-Forwarded-For to the real client address (it ignores any value the client sent),
	# and the API trusts that header only from Caddy's fixed address (FORWARDED_ALLOW_IPS).
	reverse_proxy api:8000

	header -Server
	log {
		output stdout
		format console
	}
}
