# Copy to .env next to docker-compose.yml on the server (chmod 600 .env). Never commit it.

# The API's address; its DNS "A" record must point to the server's static IP.
DOMAIN=api.your-domain.com

# Generate each with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
POSTGRES_PASSWORD=
JWT_SECRET=

# E-mail through Gmail (App Password); leave EMAIL_BACKEND=log to only write e-mails to the logs.
EMAIL_BACKEND=smtp
SMTP_USERNAME=
SMTP_PASSWORD=

# Push notifications: put the Firebase service-account JSON in ./secrets/fcm.json, then set fcm.
PUSH_BACKEND=log

# Google / Apple sign-in (JSON lists) and the RevenueCat webhook secret; may stay empty.
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=
REVENUECAT_WEBHOOK_SECRET=

# Nightly backups (deploy/backup.sh): where to keep them, how long, and an optional S3 copy.
BACKUP_DIR=/var/backups/foyo
BACKUP_KEEP_DAYS=14
# BACKUP_S3_URI=s3://your-bucket/foyo
